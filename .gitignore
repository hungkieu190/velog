# ============================================================
# VeLog — .gitignore
# ============================================================

# Composer
/vendor/

# npm / Node
/node_modules/
yarn.lock

# Build artifacts
!/assets/css/.gitkeep
!/assets/js/.gitkeep

# Distribution zip
/dist/

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# PHP
*.log
/tmp/

# WordPress
wp-config.php

# Test artifacts
/tests/.phpunit.result.cache
/tests/.phpunit.cache/
/coverage/
/.phpunit.cache/

# PHPStan cache
.phpstan/

# Environment
.env
.env.*
!.env.example

# Reports & Release artifacts
/reports/
/release/

# Production assets and lockfiles are tracked; only development maps are ignored.
/assets/js/**/*.map
/assets/css/**/*.map
/.cache/
!.env.*.example

# Sanitized workflow verification evidence is shared with reviewers.
!/ai-document/evidence/*.log
