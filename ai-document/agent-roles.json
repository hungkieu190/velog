{
  "schema_version": 2,
  "project": "velog",
  "assignments": {
    "codex": {
      "role": "backend_architect",
      "display_name": "Backend Architect"
    },
    "antigravity": {
      "role": "frontend_developer",
      "display_name": "Frontend Developer"
    },
