{
    "name": "mf/velog",
    "description": "VeLog — Digital Vehicle Passport for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://mamflow.com/velog",
    "authors": [
        {
            "name": "Mamflow",
            "homepage": "https://mamflow.com"
        }
    ],
    "keywords": [
        "wordpress",
        "plugin",
        "vehicle",
        "passport",
        "repair-shop"
    ],
    "support": {
        "issues": "https://mamflow.com/support",
        "source": "https://mamflow.com/velog"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpstan/phpstan": "^1.12",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "MF\\VeLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MF\\VeLog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpcs": "phpcs --standard=phpcs.xml",
        "phpcbf": "phpcbf --standard=phpcs.xml",
        "phpstan": "phpstan analyse --configuration=phpstan.neon",
        "test": "phpunit --configuration=tests/phpunit.xml",
        "lint": [
            "@phpcs",
            "@phpstan"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
