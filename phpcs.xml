<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         name="VeLog"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">

    <description>VeLog plugin: WordPress Coding Standards ruleset by Mamflow</description>

    <file>velog.php</file>
    <file>uninstall.php</file>
    <file>src/</file>
    <file>tests/</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>assets/*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>
    <exclude-pattern>*.min.css</exclude-pattern>
    <!-- Integration fixtures use CLI PHP, raw mysqli, and non-WP stubs by design. -->
    <exclude-pattern>tests/fixtures/*</exclude-pattern>
    <exclude-pattern>tests/workflow/*</exclude-pattern>

    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    </rule>

    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="mf_velog_manage_customers"/>
                <element value="mf_velog_manage_vehicles"/>
                <element value="mf_velog_create_services"/>
                <element value="mf_velog_read_records"/>
                <element value="mf_velog_manage_reminders"/>
                <element value="mf_velog_manage_settings"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>

    <!--
        DATA-001 contract: Storage/ classes use raw mysqli on a pinned connection
        for transactional writes. $wpdb helpers cannot guarantee a write stays on
        the locked connection (core reconnects on error 2006). Direct-access sniffs
        are suppressed for the Storage layer; security is enforced via parameterized
        SQL with mysqli_real_escape_string inside trusted-only code paths.
    -->
    <rule ref="WordPress.DB.RestrictedFunctions">
        <exclude-pattern>src/Common/Storage/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>src/Common/Storage/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.DB.PreparedSQL">
        <exclude-pattern>src/Common/Storage/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security.EscapeOutput">
        <exclude-pattern>src/Common/Storage/*</exclude-pattern>
    </rule>

    <!-- Test fixtures and test bootstrap define lightweight stubs for testing. -->
    <rule ref="Universal.Files.SeparateFunctionsFromOO">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.OneObjectStructurePerFile">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <config name="minimum_supported_wp_version" value="6.4"/>
    <config name="testVersion" value="8.1-"/>
    <config name="text_domain" value="velog"/>

    <ini name="error_reporting" value="E_ALL"/>
    <ini name="display_errors" value="1"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

</ruleset>
